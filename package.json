{
  "name": "doc-consistency",
  "version": "1.1.0",
  "description": "Check a long document against itself — cross-reference integrity, numbering continuity, terminology drift, TOC-vs-body mismatch, leftover placeholders, merge loss. Offline, deterministic, zero dependencies.",
  "keywords": [
    "document-consistency",
    "cross-reference",
    "proofreading",
    "docx",
    "publishing",
    "proposal",
    "rfp",
    "compliance-matrix",
    "technical-writing",
    "offline",
    "zero-dependency",
    "agent-skill"
  ],
  "type": "module",
  "bin": {
    "doc-consistency": "scripts/check.mjs"
  },
  "main": "scripts/lib/rules.mjs",
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "SKILL.md",
    "examples/",
    "scripts/"
  ],
  "scripts": {
    "test": "node scripts/selftest.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongsheng123132/doc-consistency.git"
  },
  "homepage": "https://u-king.org"
}
